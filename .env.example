# ==============================================================================
# Plantilla de Variables de Entorno (.env.example) - llm-wiki-assistant
# Copia este fichero a .env y completa los valores reales. NUNCA subas .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Moodle y MariaDB
# ------------------------------------------------------------------------------
MOODLE_DOCKER_PORT=8000
MARIADB_DOCKER_PORT=3306
MOODLE_DATABASE_USER=moodleuser
MOODLE_DATABASE_PASSWORD=moodlepassword_CHANGE_ME
MOODLE_DATABASE_NAME=moodle_db
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=adminpass123_CHANGE_ME

# ------------------------------------------------------------------------------
# 2. Matrix Synapse y Element Web
# ------------------------------------------------------------------------------
SYNAPSE_DOCKER_PORT=8008
ELEMENT_DOCKER_PORT=8081
SYNAPSE_SERVER_NAME=localhost
SYNAPSE_ADMIN_USER=admin
SYNAPSE_ADMIN_PASSWORD=adminpass123_CHANGE_ME
MATRIX_ACCESS_TOKEN=syt_CHANGE_ME

# ------------------------------------------------------------------------------
# 3. GitHub
# ------------------------------------------------------------------------------
GITHUB_ORG=julia8873
GITHUB_TEMPLATE_REPO=BdC-template
GITHUB_DEFAULT_BRANCH=main
GITHUB_PAT=ghp_CHANGE_ME

# ------------------------------------------------------------------------------
# 4. Proveedores LLM
# ------------------------------------------------------------------------------
# OpenAI (proveedor por defecto). También válido para Azure OpenAI, vLLM, LM Studio.
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (alternativa)
GEMINI_API_KEY=AIzaSy_CHANGE_ME

# Ollama local (alternativa, solo si se activa el perfil Docker "ollama")
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 5. Maubot
# ------------------------------------------------------------------------------
MAUBOT_DOCKER_PORT=29317
MAUBOT_ADMIN_USER=admin
MAUBOT_ADMIN_PASSWORD=maubotpass_CHANGE_ME
# Clave para cifrar el store E2EE del bot en disco (Olm/Megolm).
# Genera con: python3 -c "import secrets; print(secrets.token_hex(32))"
MAUBOT_CRYPTO_PICKLE_KEY=CHANGE_ME_GENERATE_RANDOM
