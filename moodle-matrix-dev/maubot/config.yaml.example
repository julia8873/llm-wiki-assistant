# ==============================================================================
# PLANTILLA config.yaml — Plugin llm-wiki-assistant en Maubot
# Copia a moodle-matrix-dev/maubot/config.yaml y rellena los secretos.
# ==============================================================================
homeserver:
  url: "http://matrix-synapse:8008"
  server_name: "localhost"

bot_user:
  mxid: "@llm_wiki_bot:localhost"
  access_token: "syt_CHANGE_ME"

plugin_config:
  github_pat: "ghp_CHANGE_ME"
  github_org: "julia8873"
  default_branch: "main"

  # Proveedor LLM activo: "openai" (defecto) | "gemini" | "ollama"
  llm_provider: "openai"

  openai_api_key: "sk-CHANGE_ME"
  openai_base_url: "https://api.openai.com/v1"
  openai_model: "gpt-4o-mini"

  gemini_api_key: "AIzaSy_CHANGE_ME"
  gemini_base_url: "https://generativelanguage.googleapis.com/v1beta"
  gemini_model: "gemini-3.5-flash"

  ollama_base_url: "http://ollama-llm-service:<OLLAMA_PORT>"
  ollama_model: "llama3"

  moodle_api_url: "http://moodle-matrix-dev-moodle-1:8000"
  moodle_wstoken: "CHANGE_ME"
